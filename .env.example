# ─────────────────────────────────────────────────────────────────────────────
# Enterprise Knowledge Assistant — Environment Configuration
# Copy this file to .env and fill in real values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (local dev). Switch to postgresql+psycopg2://... for production.
DATABASE_URL=sqlite:///./data/app.db

# ── Storage Paths ─────────────────────────────────────────────────────────────
UPLOAD_DIR=data/uploads
VECTOR_INDEX_DIR=data/vector_index
SAMPLE_DOCUMENTS_DIR=data/sample_documents

# ── Ollama / LLM ──────────────────────────────────────────────────────────────
# When running in Docker, use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b
LLM_TIMEOUT_SECONDS=120.0
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1
LLM_CONTEXT_WINDOW=4096

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MIN_CHUNK_SIZE=100

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=10
RETRIEVAL_FETCH_K=20
SIMILARITY_THRESHOLD=0.3
EVIDENCE_THRESHOLD=0.25

# ── Optional Reranker (disabled by default — requires ~200 MB RAM) ────────────
ENABLE_RERANKER=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=5

# ── Optional Query Rewriting ─────────────────────────────────────────────────
ENABLE_QUERY_REWRITING=false

# ── Context / Conversation ────────────────────────────────────────────────────
MAX_CONTEXT_TOKENS=2000
MAX_CONVERSATION_TURNS=6

# ── Upload Limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_BYTES=52428800

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
