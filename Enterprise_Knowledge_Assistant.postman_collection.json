{
  "info": {
    "name": "Enterprise Knowledge Assistant — Production RAG Platform",
    "_postman_id": "7f8b91a2-c3d4-4e5f-b6a7-890123456789",
    "description": "Complete Postman collection for the Enterprise Knowledge Assistant RAG platform.\n\n### Quick Start:\n1. Ensure the server is running (`uvicorn app.main:app --reload`).\n2. Open the **2. Authentication / Login (JSON or Form)** request and hit **Send**.\n3. The test script automatically sets the `{{accessToken}}` collection variable!\n4. All protected endpoints (Documents, Q&A, Conversations) will automatically use this token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "documentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "conversationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "evalRunId",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Health & Readiness",
      "item": [
        {
          "name": "Liveness Check",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Checks basic service availability."
          }
        },
        {
          "name": "Deep Readiness Check",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ready",
              "host": ["{{baseUrl}}"],
              "path": ["ready"]
            },
            "description": "Verifies SQLite DB, FAISS Vector Index, and SQLite FTS5 stores are all healthy."
          }
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Register User (JSON)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"test_user\",\n  \"email\": \"test_user@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Register a new user using JSON payload."
          }
        },
        {
          "name": "Register User (Form Data)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "form_user",
                  "type": "text"
                },
                {
                  "key": "email",
                  "value": "form_user@example.com",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "SecurePass123!",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Register a new user using application/x-www-form-urlencoded."
          }
        },
        {
          "name": "Login (JSON)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.access_token) {",
                  "    pm.collectionVariables.set('accessToken', res.access_token);",
                  "    pm.collectionVariables.set('refreshToken', res.refresh_token);",
                  "    console.log('Access token saved to collection variables.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"StrongPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/token",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "token"]
            },
            "description": "Login using JSON. Automatically saves accessToken to collection variables."
          }
        },
        {
          "name": "Login (Form Data)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.access_token) {",
                  "    pm.collectionVariables.set('accessToken', res.access_token);",
                  "    pm.collectionVariables.set('refreshToken', res.refresh_token);",
                  "    console.log('Access token saved to collection variables.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "admin",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "StrongPassword123!",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/auth/token",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "token"]
            },
            "description": "Login using standard OAuth2 Form URL Encoded. Automatically saves accessToken to collection variables."
          }
        },
        {
          "name": "Refresh Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.access_token) {",
                  "    pm.collectionVariables.set('accessToken', res.access_token);",
                  "    pm.collectionVariables.set('refreshToken', res.refresh_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            },
            "description": "Exchange a refresh token for a new access token pair."
          }
        },
        {
          "name": "Get Current User Profile (/me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Returns currently authenticated user profile."
          }
        }
      ]
    },
    {
      "name": "3. Documents & Ingestion",
      "item": [
        {
          "name": "Upload Document (PDF or DOCX)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.document_id) {",
                  "    pm.collectionVariables.set('documentId', res.document_id);",
                  "    console.log('Saved documentId:', res.document_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "data/sample_documents/employee_handbook_2026.docx",
                  "description": "Select employee_handbook_2026.docx, information_security_policy.pdf, or cloud_infrastructure_guide.docx"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/documents",
              "host": ["{{baseUrl}}"],
              "path": ["documents"]
            },
            "description": "Upload a PDF or DOCX file. Returns 202 Accepted and starts background ingestion."
          }
        },
        {
          "name": "List User Documents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents?skip=0&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["documents"],
              "query": [
                {
                  "key": "skip",
                  "value": "0"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "List documents accessible to current user with pagination."
          }
        },
        {
          "name": "Get Document Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents/{{documentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["documents", "{{documentId}}"]
            },
            "description": "Retrieve metadata for a specific document."
          }
        },
        {
          "name": "Get Ingestion Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents/{{documentId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["documents", "{{documentId}}", "status"]
            },
            "description": "Poll the ingestion pipeline status (pending -> processing -> ready / failed)."
          }
        },
        {
          "name": "Trigger Re-index Document",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents/{{documentId}}/reindex",
              "host": ["{{baseUrl}}"],
              "path": ["documents", "{{documentId}}", "reindex"]
            },
            "description": "Re-run parsing, chunking, and embedding for a document."
          }
        },
        {
          "name": "Delete Document",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents/{{documentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["documents", "{{documentId}}"]
            },
            "description": "Soft-delete a document and purge all associated vector/FTS embeddings."
          }
        }
      ]
    },
    {
      "name": "4. Q&A & Conversations (RAG)",
      "item": [
        {
          "name": "Stateless Ask (Single Question)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"How many days of paid annual leave do employees get?\",\n  \"top_k\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ask",
              "host": ["{{baseUrl}}"],
              "path": ["ask"]
            },
            "description": "Ask a single-turn question across all accessible indexed documents with citations & confidence score."
          }
        },
        {
          "name": "Create Conversation Thread",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.id) {",
                  "    pm.collectionVariables.set('conversationId', res.id);",
                  "    console.log('Saved conversationId:', res.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"HR & Leave Policy Inquiry\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/conversations",
              "host": ["{{baseUrl}}"],
              "path": ["conversations"]
            },
            "description": "Initialize a new multi-turn conversation thread."
          }
        },
        {
          "name": "List Conversations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/conversations?skip=0&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["conversations"],
              "query": [
                {
                  "key": "skip",
                  "value": "0"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "List all active conversations for the authenticated user."
          }
        },
        {
          "name": "Get Conversation Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/conversations/{{conversationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["conversations", "{{conversationId}}"]
            },
            "description": "Get full conversation thread history."
          }
        },
        {
          "name": "Ask in Conversation (Multi-turn)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Can unused leave be carried over into next year?\",\n  \"top_k\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/conversations/{{conversationId}}/messages",
              "host": ["{{baseUrl}}"],
              "path": ["conversations", "{{conversationId}}", "messages"]
            },
            "description": "Send a question within a conversation thread. Maintains chat history context."
          }
        },
        {
          "name": "Delete Conversation",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/conversations/{{conversationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["conversations", "{{conversationId}}"]
            },
            "description": "Delete a conversation and all its messages."
          }
        }
      ]
    },
    {
      "name": "5. Evaluation & Quality (Admin)",
      "item": [
        {
          "name": "Trigger Evaluation Run",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.run_id) {",
                  "    pm.collectionVariables.set('evalRunId', res.run_id);",
                  "    console.log('Saved evalRunId:', res.run_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"benchmark_name\": \"core_rag_benchmark\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/eval/run",
              "host": ["{{baseUrl}}"],
              "path": ["eval", "run"]
            },
            "description": "Trigger evaluation benchmark against the golden dataset (requires admin role)."
          }
        },
        {
          "name": "List Evaluation Runs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/eval/runs",
              "host": ["{{baseUrl}}"],
              "path": ["eval", "runs"]
            },
            "description": "List all historical evaluation runs and aggregate metrics."
          }
        },
        {
          "name": "Get Evaluation Run Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/eval/runs/{{evalRunId}}",
              "host": ["{{baseUrl}}"],
              "path": ["eval", "runs", "{{evalRunId}}"]
            },
            "description": "Retrieve detailed scores (faithfulness, relevance, context recall) for a specific evaluation run."
          }
        }
      ]
    }
  ]
}
